{
  "name": "krakens-brain-tl",
  "description": "Second Brain para Maestro TL - Krakens Performance OS",
  "version": "1.0.0",
  "integrations": {
    "github": {
      "enabled": true,
      "repository": "krakens-brain",
      "owner": "hermes-emerson",
      "branch": "main",
      "sync_interval": "daily",
      "webhook_events": ["push"]
    },
    "hermes": {
      "agent_type": "maestro-tl",
      "access_pattern": "read-first",
      "cache_strategy": "mapa-first",
      "update_strategy": "agent-write"
    },
    "compose": {
      "enabled": true,
      "service": "github-krakens-brain"
    }
  },
  "folders": {
    "metricas": {
      "type": "metrics",
      "update_frequency": "real-time",
      "primary_source": "dredge",
      "schema": "dashboard.md"
    },
    "vendedores": {
      "type": "profiles",
      "update_frequency": "daily",
      "primary_source": "scope-codex",
      "schema": "_template.md"
    },
    "playbook": {
      "type": "rules",
      "update_frequency": "weekly",
      "primary_source": "maestro",
      "schema": "_template.md"
    },
    "funil": {
      "type": "analysis",
      "update_frequency": "real-time",
      "primary_source": "undertow-codex",
      "schema": "_template.md"
    },
    "historico": {
      "type": "decisions",
      "update_frequency": "on-action",
      "primary_source": "maestro",
      "schema": "_template.md"
    },
    "alertas": {
      "type": "alerts",
      "update_frequency": "real-time",
      "primary_source": "dredge",
      "schema": "_template.md"
    },
    "agentes": {
      "type": "orchestration",
      "update_frequency": "manual",
      "primary_source": "maestro"
    }
  },
  "access_control": {
    "maestro_tl": {
      "read": ["*"],
      "write": ["historico", "alertas"],
      "admin": false
    },
    "dredge": {
      "read": ["metricas", "alertas"],
      "write": ["metricas", "alertas"],
      "admin": false
    },
    "scope_codex": {
      "read": ["vendedores", "funil"],
      "write": ["vendedores"],
      "admin": false
    },
    "undertow_codex": {
      "read": ["funil"],
      "write": ["funil"],
      "admin": false
    }
  },
  "agent_configs": {
    "dredge": {
      "enabled": true,
      "model": "claude-opus-5-5",
      "system_prompt": "Você é DREDGE, agente extrator de dados Krakens. Sua responsabilidade: puxar APENAS dados numéricos do Google Data Studio. Nunca invente. Se não encontrar um dado, diga 'indisponível'. Sempre estruture em tabelas claras. Nada de análise — só números e fatos.",
      "data_source": "https://datastudio.google.com/u/0/reporting/1ddab9e7-94ff-4047-8b66-25b3a92db785/page/p_4pnnpzb75d",
      "skills": ["report-today", "report-month", "report-seller", "report-funnel", "alerts-check"],
      "cache": "aggressive",
      "output_format": "markdown"
    },
    "scope_codex": {
      "enabled": false,
      "status": "backup",
      "reason": "Qualitative analysis - ativar quando Supabase estiver ready"
    },
    "undertow_codex": {
      "enabled": false,
      "status": "backup",
      "reason": "Quality audit - ativar quando rubrica estiver validada"
    }
  },
  "notes": "Criado em 2026-10-01. DREDGE ativo e conectado ao Google Data Studio. Scope/Undertow em backup."
}
